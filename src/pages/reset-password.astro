---
export const prerender = false;
import Layout from '../components/Layout.astro';
---
<Layout title="Reset Password | InfoDogCats" description="Set your new InfoDogCats password.">
  <div class="min-h-screen bg-gradient-to-br from-warm-white via-cream to-sand/20 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 mb-4">
          <div class="w-12 h-12 bg-terracotta rounded-2xl flex items-center justify-center shadow-md">
            <span class="text-2xl">🐱</span>
          </div>
          <span class="font-display text-2xl font-bold text-charcoal">InfoDog<span class="text-terracotta">Cats</span></span>
        </a>
        <div class="w-16 h-16 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-3xl">🔐</span>
        </div>
        <h1 class="font-display text-3xl font-bold text-charcoal">Set New Password</h1>
        <p class="text-gray-400 text-sm mt-2">Choose a strong password for your account</p>
      </div>

      <div class="bg-white rounded-2xl p-8 border border-sand/30 shadow-sm space-y-4">

        <div>
          <label class="block text-sm font-semibold text-charcoal mb-1.5">New Password</label>
          <div class="relative">
            <input type="password" id="new-password" required minlength="8"
              placeholder="Minimum 8 characters"
              class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 transition-all pr-16" />
            <button type="button" id="toggle-pw"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-gray-400 hover:text-charcoal">Show</button>
          </div>
          <div class="mt-2 h-1.5 bg-gray-100 rounded-full overflow-hidden">
            <div id="pw-bar" class="h-full rounded-full transition-all duration-300 w-0"></div>
          </div>
          <p id="pw-text" class="text-xs text-gray-400 mt-1">Enter a password</p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-charcoal mb-1.5">Confirm New Password</label>
          <input type="password" id="confirm-password" required
            placeholder="Repeat your password"
            class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 transition-all" />
          <p id="pw-match" class="text-xs mt-1 hidden"></p>
        </div>

        <div id="rp-error" class="hidden bg-red-50 text-red-600 text-xs rounded-xl px-4 py-3 border border-red-200"></div>
        <div id="rp-success" class="hidden bg-green-50 text-green-700 rounded-xl px-5 py-4 border border-green-200 text-center">
          <p class="text-2xl mb-2">✅</p>
          <p class="font-semibold text-sm">Password updated!</p>
          <p class="text-xs mt-1 text-green-600">Redirecting to your dashboard...</p>
        </div>

        <button id="rp-btn"
          class="w-full bg-terracotta text-white py-3.5 rounded-xl font-semibold text-sm hover:bg-terracotta-light transition-all shadow-sm disabled:opacity-60">
          Update Password →
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';
  const sb = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

  const pwInput = document.getElementById('new-password');
  const confirmPw = document.getElementById('confirm-password');

  document.getElementById('toggle-pw')?.addEventListener('click', () => {
    const isText = pwInput.type === 'text';
    pwInput.type = isText ? 'password' : 'text';
    document.getElementById('toggle-pw').textContent = isText ? 'Show' : 'Hide';
  });

  pwInput?.addEventListener('input', () => {
    const val = pwInput.value;
    let score = 0;
    if (val.length >= 8) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    const levels = [
      { w: '0%', color: '', text: 'Enter a password' },
      { w: '25%', color: 'bg-red-400', text: 'Weak' },
      { w: '50%', color: 'bg-amber-400', text: 'Fair' },
      { w: '75%', color: 'bg-blue-400', text: 'Good' },
      { w: '100%', color: 'bg-green-500', text: 'Strong ✓' },
    ];
    const level = val.length === 0 ? levels[0] : levels[score];
    const bar = document.getElementById('pw-bar');
    bar.style.width = level.w;
    bar.className = `h-full rounded-full transition-all duration-300 ${level.color}`;
    document.getElementById('pw-text').textContent = level.text;
  });

  confirmPw?.addEventListener('input', () => {
    const match = document.getElementById('pw-match');
    if (!confirmPw.value) { match.classList.add('hidden'); return; }
    match.classList.remove('hidden');
    if (confirmPw.value === pwInput.value) {
      match.textContent = '✓ Passwords match';
      match.className = 'text-xs mt-1 text-green-600';
    } else {
      match.textContent = '✗ Passwords do not match';
      match.className = 'text-xs mt-1 text-red-500';
    }
  });

  document.getElementById('rp-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('rp-btn');
    const err = document.getElementById('rp-error');
    const ok = document.getElementById('rp-success');
    const pw = pwInput.value;
    const confirm = confirmPw.value;

    err.classList.add('hidden');

    if (pw.length < 8) {
      err.textContent = 'Password must be at least 8 characters.';
      err.classList.remove('hidden');
      return;
    }
    if (pw !== confirm) {
      err.textContent = 'Passwords do not match.';
      err.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Updating...';

    const { error } = await sb.auth.updateUser({ password: pw });

    if (error) {
      err.textContent = error.message;
      err.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Update Password →';
    } else {
      ok.classList.remove('hidden');
      btn.classList.add('hidden');
      setTimeout(() => window.location.href = '/dashboard', 2500);
    }
  });
</script>
