---
export const prerender = false;
import Layout from '../components/Layout.astro';
import { createClient } from '@supabase/supabase-js';

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_SERVICE_ROLE = import.meta.env.SUPABASE_SERVICE_ROLE;
const ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/webp'];
const MAX_SIZE = 2 * 1024 * 1024;

if (Astro.request.method === 'POST') {
  const contentType = Astro.request.headers.get('content-type') || '';

  // reCAPTCHA verification
  if (contentType.includes('application/json')) {
    try {
      const body = await Astro.request.json();

      // إذا كان طلب حفظ الإعلان
      if (body.action === 'save-ad') {
        const { recaptchaToken, accessToken, adData } = body;

        // 1. التحقق من reCAPTCHA
        const verify = await fetch('https://www.google.com/recaptcha/api/siteverify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: `secret=${import.meta.env.RECAPTCHA_SECRET_KEY}&response=${recaptchaToken}`
        });
        const captchaResult = await verify.json();
        if (!captchaResult.success) {
          return new Response(JSON.stringify({ error: 'reCAPTCHA failed' }), {
            status: 400, headers: { 'Content-Type': 'application/json' }
          });
        }

        // 2. التحقق من المستخدم عبر access token
        const userSb = createClient(SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY, {
          global: { headers: { Authorization: `Bearer ${accessToken}` } }
        });
        const { data: { user }, error: userErr } = await userSb.auth.getUser();
        if (userErr || !user) {
          return new Response(JSON.stringify({ error: 'Unauthorized' }), {
            status: 401, headers: { 'Content-Type': 'application/json' }
          });
        }

        // 3. حفظ الإعلان باستخدام Service Role (يتجاوز RLS بأمان)
        const adminSb = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE);
        const { data: cat, error: catErr } = await adminSb.from('cats').insert({
          ...adData,
          user_id: user.id  // يجب أن يكون بعد adData لتجاوز أي user_id مرسل من المتصفح
        }).select().single();

        if (catErr) {
          return new Response(JSON.stringify({ error: catErr.message }), {
            status: 500, headers: { 'Content-Type': 'application/json' }
          });
        }

        return new Response(JSON.stringify({ success: true, cat }), {
          status: 200, headers: { 'Content-Type': 'application/json' }
        });
      }

      // reCAPTCHA only check
      const { recaptchaToken } = body;
      if (!recaptchaToken) {
        return new Response(JSON.stringify({ error: 'reCAPTCHA token missing' }), {
          status: 400, headers: { 'Content-Type': 'application/json' }
        });
      }
      const verify = await fetch('https://www.google.com/recaptcha/api/siteverify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `secret=${import.meta.env.RECAPTCHA_SECRET_KEY}&response=${recaptchaToken}`
      });
      const result = await verify.json();
      if (!result.success) {
        return new Response(JSON.stringify({ error: 'reCAPTCHA failed' }), {
          status: 400, headers: { 'Content-Type': 'application/json' }
        });
      }
      return new Response(JSON.stringify({ success: true }), {
        status: 200, headers: { 'Content-Type': 'application/json' }
      });
    } catch (e) {
      return new Response(JSON.stringify({ error: 'Server error' }), {
        status: 500, headers: { 'Content-Type': 'application/json' }
      });
    }
  }

  // File upload validation
  if (contentType.includes('multipart/form-data')) {
    try {
      const formData = await Astro.request.formData();
      const files = formData.getAll('images') as File[];
      for (const file of files) {
        if (!ALLOWED_TYPES.includes(file.type)) {
          return new Response(JSON.stringify({ error: `Invalid file type. Only JPG, PNG, WebP allowed.` }), {
            status: 400, headers: { 'Content-Type': 'application/json' }
          });
        }
        if (file.size > MAX_SIZE) {
          return new Response(JSON.stringify({ error: `File too large. Max 2MB per image.` }), {
            status: 400, headers: { 'Content-Type': 'application/json' }
          });
        }
      }
      return new Response(JSON.stringify({ success: true }), {
        status: 200, headers: { 'Content-Type': 'application/json' }
      });
    } catch (e) {
      return new Response(JSON.stringify({ error: 'File validation error' }), {
        status: 500, headers: { 'Content-Type': 'application/json' }
      });
    }
  }
}
---
<Layout
  title="Post a Free Cat Ad in Australia | InfoDogCats"
  description="List your cat or kitten for sale for free. Reach thousands of cat lovers across Australia."
>
  <div class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="font-display text-3xl font-bold text-charcoal mb-1">Post a Free Cat Ad</h1>
    <p class="text-gray-400 text-sm mb-8">Reach thousands of cat lovers across Australia. Completely free.</p>

    <div id="auth-required" class="hidden bg-amber-50 border border-amber-200 rounded-2xl p-6 text-center mb-6">
      <p class="font-semibold text-amber-800 mb-1">Account required to post ads</p>
      <p class="text-amber-700 text-sm mb-4">Create a free account in 30 seconds</p>
      <div class="flex gap-3 justify-center">
        <a href="/login?next=/post-ad" class="bg-terracotta text-white px-5 py-2.5 rounded-full font-semibold text-sm">Sign In</a>
        <a href="/register" class="border border-terracotta text-terracotta px-5 py-2.5 rounded-full font-semibold text-sm">Create Account</a>
      </div>
    </div>

    <form id="post-form" class="space-y-5 bg-white rounded-2xl p-6 border border-sand/30 shadow-sm">
      <div>
        <label class="block text-sm font-semibold text-charcoal mb-1.5">Ad Title <span class="text-terracotta">*</span></label>
        <input type="text" name="title" required maxlength="80"
          placeholder="e.g. Beautiful Maine Coon Kittens Ready to Go"
          class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50" />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-charcoal mb-1.5">Breed <span class="text-terracotta">*</span></label>
          <input type="text" name="breed" required maxlength="50" placeholder="e.g. Ragdoll"
            class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-charcoal mb-1.5">Price (AUD) <span class="text-terracotta">*</span></label>
          <input type="number" name="price" required min="0" max="99999" step="50" placeholder="e.g. 1200"
            class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-charcoal mb-1.5">Age (months)</label>
        <input type="number" name="age_months" min="0" max="240" placeholder="e.g. 3"
          class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50" />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-charcoal mb-1.5">City <span class="text-terracotta">*</span></label>
          <input type="text" name="city" required maxlength="50" placeholder="e.g. Sydney"
            class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-charcoal mb-1.5">State <span class="text-terracotta">*</span></label>
          <select name="state" required
            class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50">
            <option value="">Select</option>
            {['NSW','VIC','QLD','WA','SA','TAS','ACT','NT'].map((s: string) => <option value={s}>{s}</option>)}
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-charcoal mb-1.5">Description <span class="text-terracotta">*</span></label>
        <textarea name="description" required rows={5} maxlength="2000"
          placeholder="Describe your cat: personality, health, vaccinations, microchipped, desexed, etc."
          class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 resize-none"></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-charcoal mb-1.5">Photos (up to 5)</label>
        <div id="drop-zone" class="border-2 border-dashed border-sand rounded-xl p-6 text-center cursor-pointer hover:border-terracotta transition-colors">
          <input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple id="image-input" class="hidden" />
          <p class="text-4xl mb-2">📸</p>
          <p class="text-sm text-gray-500">Click or drag photos here</p>
          <p class="text-xs text-gray-400 mt-1">JPG, PNG or WebP · Max 2MB each · Up to 5 photos</p>
        </div>
        <div id="preview" class="flex gap-2 mt-2 flex-wrap"></div>
        <div id="file-error" class="hidden text-xs text-red-500 mt-1"></div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-charcoal mb-1.5">Phone</label>
          <input type="tel" name="contact_phone" placeholder="04XX XXX XXX" maxlength="20"
            class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-charcoal mb-1.5">Email</label>
          <input type="email" name="contact_email" maxlength="100"
            class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50" />
        </div>
      </div>

      <div>
        <div class="g-recaptcha" data-sitekey={recaptchaSiteKey} data-theme="light"></div>
        <p class="text-xs text-gray-400 mt-1">Protected by reCAPTCHA — <a href="https://policies.google.com/privacy" target="_blank" class="hover:underline">Privacy</a> · <a href="https://policies.google.com/terms" target="_blank" class="hover:underline">Terms</a></p>
      </div>

      <div id="form-error" class="hidden bg-red-50 text-red-600 text-sm rounded-xl px-4 py-3 border border-red-200"></div>
      <div id="form-success" class="hidden bg-green-50 text-green-700 text-sm rounded-xl px-4 py-3 border border-green-200">
        ✅ Ad submitted! It will appear after review (usually within 24 hours). Thank you!
      </div>

      <button type="submit" id="submit-btn"
        class="w-full bg-terracotta text-white py-3.5 rounded-xl font-semibold hover:bg-terracotta-light transition-colors text-sm disabled:opacity-60">
        Submit Free Ad
      </button>
      <p class="text-xs text-gray-400 text-center">By submitting, you agree to our <a href="/terms" class="underline">Terms of Service</a></p>
    </form>
  </div>
</Layout>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    (import.meta as any).env.PUBLIC_SUPABASE_URL,
    (import.meta as any).env.PUBLIC_SUPABASE_ANON_KEY
  );

  const ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/webp'];
  const MAX_SIZE = 2 * 1024 * 1024;
  const MAX_FILES = 5;

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      document.getElementById('auth-required')?.classList.remove('hidden');
      const form = document.getElementById('post-form') as HTMLElement;
      if (form) form.style.display = 'none';
      return;
    }

    const dropZone = document.getElementById('drop-zone')!;
    const imageInput = document.getElementById('image-input') as HTMLInputElement;
    const preview = document.getElementById('preview')!;
    const fileError = document.getElementById('file-error')!;

    dropZone.addEventListener('click', () => imageInput.click());

    imageInput.addEventListener('change', () => {
      fileError.classList.add('hidden');
      preview.innerHTML = '';
      if (!imageInput.files) return;
      for (const file of Array.from(imageInput.files).slice(0, MAX_FILES)) {
        if (!ALLOWED_TYPES.includes(file.type)) {
          fileError.textContent = `Invalid file type. Only JPG, PNG, WebP allowed.`;
          fileError.classList.remove('hidden');
          imageInput.value = '';
          preview.innerHTML = '';
          return;
        }
        if (file.size > MAX_SIZE) {
          fileError.textContent = `File too large. Max 2MB per image.`;
          fileError.classList.remove('hidden');
          imageInput.value = '';
          preview.innerHTML = '';
          return;
        }
        const img = document.createElement('img');
        img.src = URL.createObjectURL(file);
        img.className = 'w-20 h-16 object-cover rounded-lg border border-sand';
        preview.appendChild(img);
      }
    });

    document.getElementById('post-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      const errorEl = document.getElementById('form-error')!;
      const successEl = document.getElementById('form-success')!;
      errorEl.classList.add('hidden');

      const captchaToken = (window as any).grecaptcha?.getResponse();
      if (!captchaToken) {
        errorEl.textContent = 'Please complete the reCAPTCHA verification.';
        errorEl.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Submitting...';

      const form = e.target as HTMLFormElement;
      const data = new FormData(form);
      const title = (data.get('title') as string).trim();
      const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') + '-' + Date.now();

      // إرسال كل شيء للسيرفر دفعة واحدة
      try {
        const res = await fetch('/post-ad', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save-ad',
            recaptchaToken: captchaToken,
            accessToken: session.access_token,
            adData: {
              title,
              slug,
              breed: (data.get('breed') as string).trim(),
              price: parseFloat(data.get('price') as string),
              age_months: data.get('age_months') ? parseInt(data.get('age_months') as string) : null,
              description: (data.get('description') as string).trim(),
              city: (data.get('city') as string).trim(),
              state: data.get('state'),
              contact_phone: data.get('contact_phone') || null,
              contact_email: data.get('contact_email') || null,
            }
          })
        });

        const result = await res.json();
        if (!res.ok) {
          errorEl.textContent = result.error || 'Error saving ad.';
          errorEl.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'Submit Free Ad';
          (window as any).grecaptcha?.reset();
          return;
        }

        const cat = result.cat;

        // رفع الصور عبر السيرفر
        const files = imageInput.files;
        if (files && files.length > 0) {
          const fileFormData = new FormData();
          fileFormData.append('cat_id', cat.id);
          fileFormData.append('access_token', session.access_token);
          Array.from(files).slice(0, MAX_FILES).forEach(f => fileFormData.append('images', f));

          await fetch('/post-ad', {
            method: 'POST',
            body: fileFormData
          });
        }

        successEl.classList.remove('hidden');
        form.reset();
        preview.innerHTML = '';
        btn.textContent = 'Submit Free Ad';
        btn.disabled = false;
        (window as any).grecaptcha?.reset();

      } catch (err) {
        errorEl.textContent = 'Network error. Please try again.';
        errorEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Submit Free Ad';
      }
    });
  }

  init();
</script>