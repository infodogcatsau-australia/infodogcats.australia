---
export const prerender = false;
import Layout from '../components/Layout.astro';
---
<Layout
  title="Create Free Account | InfoDogCats Australia"
  description="Create a free InfoDogCats account to post cat listings across Australia. Join thousands of cat lovers."
>
  <div class="min-h-screen bg-gradient-to-br from-warm-white via-cream to-sand/20 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-lg">

      <!-- Logo -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 mb-4">
          <div class="w-12 h-12 bg-terracotta rounded-2xl flex items-center justify-center shadow-md">
            <span class="text-2xl">🐱</span>
          </div>
          <span class="font-display text-2xl font-bold text-charcoal">InfoDog<span class="text-terracotta">Cats</span></span>
        </a>
        <h1 class="font-display text-3xl font-bold text-charcoal mt-2">Create Free Account</h1>
        <p class="text-gray-400 text-sm mt-1">Join Australia's cat community — free forever</p>
      </div>

      <!-- Benefits -->
      <div class="grid grid-cols-3 gap-3 mb-6">
        {[
          { icon: '📢', text: 'Post free ads' },
          { icon: '🔔', text: 'Save listings' },
          { icon: '💬', text: 'Contact sellers' },
        ].map(b => (
          <div class="bg-white rounded-xl p-3 text-center border border-sand/30 shadow-sm">
            <p class="text-xl mb-1">{b.icon}</p>
            <p class="text-xs font-medium text-charcoal">{b.text}</p>
          </div>
        ))}
      </div>

      <!-- Form -->
      <div class="bg-white rounded-2xl p-8 border border-sand/30 shadow-sm">
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label class="block text-sm font-semibold text-charcoal mb-1.5">
              First Name
            </label>
            <input type="text" id="first-name" autocomplete="given-name"
              placeholder="Sarah"
              class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 transition-all" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-charcoal mb-1.5">
              Last Name
            </label>
            <input type="text" id="last-name" autocomplete="family-name"
              placeholder="Smith"
              class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 transition-all" />
          </div>
        </div>

        <div class="mb-4">
          <label class="block text-sm font-semibold text-charcoal mb-1.5">
            Email Address <span class="text-terracotta">*</span>
          </label>
          <div class="relative">
            <input type="email" id="email" required autocomplete="email"
              placeholder="sarah@example.com.au"
              class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 transition-all pr-10" />
            <span id="email-check" class="absolute right-3 top-1/2 -translate-y-1/2 text-sm hidden"></span>
          </div>
          <p class="text-xs text-gray-400 mt-1">You'll receive a confirmation email to verify your address</p>
        </div>

        <div class="mb-4">
          <label class="block text-sm font-semibold text-charcoal mb-1.5">
            Phone <span class="text-gray-400 font-normal text-xs">(optional)</span>
          </label>
          <input type="tel" id="phone" autocomplete="tel"
            placeholder="04XX XXX XXX"
            class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 transition-all" />
        </div>

        <div class="mb-4">
          <label class="block text-sm font-semibold text-charcoal mb-1.5">
            State <span class="text-gray-400 font-normal text-xs">(optional)</span>
          </label>
          <select id="state"
            class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 transition-all text-gray-600">
            <option value="">Select your state</option>
            {['NSW','VIC','QLD','WA','SA','TAS','ACT','NT'].map(s => (
              <option value={s}>{s}</option>
            ))}
          </select>
        </div>

        <div class="mb-4">
          <label class="block text-sm font-semibold text-charcoal mb-1.5">
            Password <span class="text-terracotta">*</span>
          </label>
          <div class="relative">
            <input type="password" id="password" required minlength="8" autocomplete="new-password"
              placeholder="Minimum 8 characters"
              class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 transition-all pr-10" />
            <button type="button" id="toggle-pw"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-charcoal text-xs">
              Show
            </button>
          </div>
          <!-- Password strength bar -->
          <div class="mt-2 h-1.5 bg-gray-100 rounded-full overflow-hidden">
            <div id="pw-strength-bar" class="h-full rounded-full transition-all duration-300 w-0"></div>
          </div>
          <p id="pw-strength-text" class="text-xs text-gray-400 mt-1">Enter a password</p>
        </div>

        <div class="mb-5">
          <label class="block text-sm font-semibold text-charcoal mb-1.5">
            Confirm Password <span class="text-terracotta">*</span>
          </label>
          <input type="password" id="confirm-password" required autocomplete="new-password"
            placeholder="Repeat your password"
            class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 transition-all" />
          <p id="pw-match" class="text-xs mt-1 hidden"></p>
        </div>

        <!-- Terms -->
        <div class="flex items-start gap-2.5 mb-5">
          <input type="checkbox" id="terms" required
            class="mt-0.5 w-4 h-4 rounded border-sand text-terracotta focus:ring-terracotta/50" />
          <label for="terms" class="text-xs text-gray-500 leading-relaxed">
            I agree to InfoDogCats'
            <a href="/terms" class="text-terracotta hover:underline font-medium">Terms of Service</a>
            and
            <a href="/privacy-policy" class="text-terracotta hover:underline font-medium">Privacy Policy</a>.
            I confirm I am 18 years or older.
          </label>
        </div>

        <!-- Error / Success -->
        <div id="reg-error" class="hidden bg-red-50 text-red-600 text-xs rounded-xl px-4 py-3 border border-red-200 mb-4"></div>
        <div id="reg-success" class="hidden bg-green-50 text-green-700 text-sm rounded-xl px-4 py-4 border border-green-200 mb-4 text-center">
          <p class="text-2xl mb-2">📬</p>
          <p class="font-semibold">Check your email!</p>
          <p class="text-xs mt-1 text-green-600">We sent a confirmation link to your email address. Click it to activate your account.</p>
        </div>

        <button id="reg-btn"
          class="w-full bg-terracotta text-white py-3.5 rounded-xl font-semibold text-sm hover:bg-terracotta-light transition-all shadow-sm hover:shadow-md disabled:opacity-60">
          Create Free Account →
        </button>

        <p class="text-center text-xs text-gray-400 mt-4">
          Already have an account?
          <a href="/login" class="text-terracotta font-semibold hover:underline">Sign in</a>
        </p>
      </div>

      <!-- Trust badges -->
      <div class="flex justify-center gap-6 mt-6 text-xs text-gray-400">
        <span class="flex items-center gap-1">🔒 Secure</span>
        <span class="flex items-center gap-1">✉️ Email verified</span>
        <span class="flex items-center gap-1">🆓 Always free</span>
      </div>

    </div>
  </div>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';
  const sb = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  // Show/hide password
  const pwInput = document.getElementById('password') as HTMLInputElement;
  const toggleBtn = document.getElementById('toggle-pw');
  toggleBtn?.addEventListener('click', () => {
    const isText = pwInput.type === 'text';
    pwInput.type = isText ? 'password' : 'text';
    toggleBtn.textContent = isText ? 'Show' : 'Hide';
  });

  // Password strength
  const strengthBar = document.getElementById('pw-strength-bar')!;
  const strengthText = document.getElementById('pw-strength-text')!;
  pwInput?.addEventListener('input', () => {
    const val = pwInput.value;
    let score = 0;
    if (val.length >= 8) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    const levels = [
      { w: '0%', color: '', text: 'Enter a password' },
      { w: '25%', color: 'bg-red-400', text: 'Weak' },
      { w: '50%', color: 'bg-amber-400', text: 'Fair' },
      { w: '75%', color: 'bg-blue-400', text: 'Good' },
      { w: '100%', color: 'bg-green-500', text: 'Strong ✓' },
    ];
    const level = val.length === 0 ? levels[0] : levels[score];
    strengthBar.style.width = level.w;
    strengthBar.className = `h-full rounded-full transition-all duration-300 ${level.color}`;
    strengthText.textContent = level.text;
    strengthText.className = `text-xs mt-1 ${score >= 3 ? 'text-green-600' : 'text-gray-400'}`;
  });

  // Password match
  const confirmPw = document.getElementById('confirm-password') as HTMLInputElement;
  const matchText = document.getElementById('pw-match')!;
  confirmPw?.addEventListener('input', () => {
    if (!confirmPw.value) { matchText.classList.add('hidden'); return; }
    matchText.classList.remove('hidden');
    if (confirmPw.value === pwInput.value) {
      matchText.textContent = '✓ Passwords match';
      matchText.className = 'text-xs mt-1 text-green-600';
    } else {
      matchText.textContent = '✗ Passwords do not match';
      matchText.className = 'text-xs mt-1 text-red-500';
    }
  });

  // Email validation indicator
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const emailCheck = document.getElementById('email-check')!;
  emailInput?.addEventListener('input', () => {
    const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value);
    emailCheck.classList.remove('hidden');
    emailCheck.textContent = valid ? '✓' : '✗';
    emailCheck.className = `absolute right-3 top-1/2 -translate-y-1/2 text-sm ${valid ? 'text-green-500' : 'text-red-400'}`;
  });

  // Submit
  document.getElementById('reg-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('reg-btn') as HTMLButtonElement;
    const errEl = document.getElementById('reg-error')!;
    const okEl = document.getElementById('reg-success')!;

    // Validate
    const email = emailInput.value.trim();
    const pw = pwInput.value;
    const confirmPwVal = confirmPw.value;
    const terms = (document.getElementById('terms') as HTMLInputElement).checked;

    errEl.classList.add('hidden');

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errEl.textContent = 'Please enter a valid email address.';
      errEl.classList.remove('hidden');
      return;
    }
    if (pw.length < 8) {
      errEl.textContent = 'Password must be at least 8 characters.';
      errEl.classList.remove('hidden');
      return;
    }
    if (pw !== confirmPwVal) {
      errEl.textContent = 'Passwords do not match.';
      errEl.classList.remove('hidden');
      return;
    }
    if (!terms) {
      errEl.textContent = 'Please accept the Terms of Service to continue.';
      errEl.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Creating account...';

    const firstName = (document.getElementById('first-name') as HTMLInputElement).value.trim();
    const lastName = (document.getElementById('last-name') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
    const state = (document.getElementById('state') as HTMLSelectElement).value;

    const { error } = await sb.auth.signUp({
      email,
      password: pw,
      options: {
        emailRedirectTo: 'https://www.infodogcats.com/dashboard',
        data: {
          full_name: `${firstName} ${lastName}`.trim(),
          phone,
          state,
        }
      }
    });

    if (error) {
      errEl.textContent = error.message;
      errEl.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Create Free Account →';
    } else {
      okEl.classList.remove('hidden');
      btn.disabled = true;
      btn.textContent = 'Account Created ✓';
      (document.querySelector('form') as HTMLFormElement | null)?.reset();
    }
  });
</script>