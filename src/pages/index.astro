---
export const prerender = false;
import Layout from '../components/Layout.astro';
import CatCard from '../components/CatCard.astro';
import { supabase } from '../lib/supabase';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;

const { data: cats } = await supabase
  .from('cats')
  .select('id, slug, title, breed, price, city, state, cat_images(storage_path, is_primary)')
  .eq('status', 'active')
  .eq('is_approved', true)
  .order('created_at', { ascending: false })
  .limit(8);

const { data: posts } = await supabase
  .from('posts')
  .select('slug, title, excerpt, featured_image_path, published_at, tags')
  .eq('is_published', true)
  .order('published_at', { ascending: false })
  .limit(3);

const breeds = [
  { name: 'Maine Coon', href: '/cats-for-sale?breed=maine-coon', desc: 'Gentle giants', img: `${SUPABASE_URL}/storage/v1/object/public/cat-images/demo/01-maine-coon.jpg` },
  { name: 'Ragdoll', href: '/cats-for-sale?breed=ragdoll', desc: 'Calm & affectionate', img: `${SUPABASE_URL}/storage/v1/object/public/cat-images/demo/02-ragdoll.jpg` },
  { name: 'British Shorthair', href: '/cats-for-sale?breed=british-shorthair', desc: 'Independent', img: `${SUPABASE_URL}/storage/v1/object/public/cat-images/demo/03-british-shorthair.jpg` },
  { name: 'Siamese', href: '/cats-for-sale?breed=siamese', desc: 'Vocal & social', img: `${SUPABASE_URL}/storage/v1/object/public/cat-images/demo/04-siamese.jpg` },
  { name: 'Burmese', href: '/cats-for-sale?breed=burmese', desc: "Australia's favourite", img: `${SUPABASE_URL}/storage/v1/object/public/cat-images/demo/05-burmese.jpg` },
  { name: 'Persian', href: '/cats-for-sale?breed=persian', desc: 'Elegant & calm', img: `${SUPABASE_URL}/storage/v1/object/public/cat-images/demo/06-persian.jpg` },
  { name: 'Devon Rex', href: '/cats-for-sale?breed=devon-rex', desc: 'Playful & curly', img: `${SUPABASE_URL}/storage/v1/object/public/cat-images/demo/07-devon-rex.jpg` },
  { name: 'Abyssinian', href: '/cats-for-sale?breed=abyssinian', desc: 'Active & curious', img: `${SUPABASE_URL}/storage/v1/object/public/cat-images/demo/08-abyssinian.jpg` },
];

const cities = [
  { name: 'Sydney', state: 'NSW' },
  { name: 'Melbourne', state: 'VIC' },
  { name: 'Brisbane', state: 'QLD' },
  { name: 'Perth', state: 'WA' },
  { name: 'Adelaide', state: 'SA' },
  { name: 'Gold Coast', state: 'QLD' },
  { name: 'Canberra', state: 'ACT' },
  { name: 'Hobart', state: 'TAS' },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "InfoDogCats Australia",
  "url": "https://www.infodogcats.com",
  "description": "Australia's free platform for cats and kittens for sale",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://www.infodogcats.com/cats-for-sale?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<Layout
  title="Kittens & Cats for Sale in Australia | InfoDogCats"
  description="Find kittens and cats for sale near you across Australia. Browse Maine Coon, Ragdoll, Siamese, Burmese & more. Free listings in Sydney, Melbourne, Brisbane, Perth."
  schema={schema}
>

  <!-- HERO -->
  <section class="relative bg-gradient-to-br from-[#FDF8F3] via-[#FBF4EC] to-[#F5EDE0] overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-20 -right-20 w-96 h-96 bg-terracotta/8 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-sand/30 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
      <div class="grid lg:grid-cols-2 gap-10 items-center">

        <!-- Left: Text -->
        <div>
          <div class="inline-flex items-center gap-2 bg-terracotta/10 text-terracotta px-4 py-2 rounded-full text-xs font-bold uppercase tracking-widest mb-6">
            <span class="w-1.5 h-1.5 bg-terracotta rounded-full animate-pulse"></span>
            Australia's #1 Cat Marketplace
          </div>
          <h1 class="font-display text-5xl md:text-6xl font-bold text-gray-950 leading-[1.08] mb-5">
            Find Your Perfect<br/>
            <span class="text-terracotta">Feline</span> Companion
          </h1>
          <p class="text-gray-600 text-lg max-w-lg mb-8 leading-relaxed">
            Connect directly with responsible breeders and owners across Australia. 100% free, no middlemen.
          </p>
          <form action="/cats-for-sale" method="get" class="flex flex-col sm:flex-row gap-3 max-w-xl mb-7">
            <div class="flex flex-1 bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
              <select name="state" class="bg-transparent border-r border-gray-100 px-4 py-3.5 text-sm font-medium text-gray-600 focus:outline-none w-28 flex-shrink-0">
                <option value="">All States</option>
                {['NSW','VIC','QLD','WA','SA','TAS','ACT','NT'].map(s => (
                  <option value={s}>{s}</option>
                ))}
              </select>
              <input type="text" name="q" placeholder="Search breed, e.g. Maine Coon..."
                class="flex-1 px-4 py-3.5 text-sm focus:outline-none bg-transparent text-gray-900 placeholder-gray-400" />
            </div>
            <button type="submit" class="bg-terracotta text-white px-7 py-3.5 rounded-2xl font-semibold hover:bg-terracotta-light transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5 whitespace-nowrap text-sm">
              Search Cats
            </button>
          </form>
          <div class="flex flex-wrap gap-2.5 text-xs text-gray-600">
            {['Free to list', 'Direct from owners', 'Australia-wide', 'No agency fees'].map(t => (
              <span class="flex items-center gap-1.5 bg-white/80 px-3 py-1.5 rounded-full border border-gray-200 font-medium shadow-sm">
                <svg class="w-3 h-3 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {t}
              </span>
            ))}
          </div>
        </div>

        <!-- Right: Photos -->
        <div class="hidden lg:grid grid-cols-2 gap-3 relative">
          <div class="col-span-2 rounded-2xl overflow-hidden shadow-md bg-warm-white" style="aspect-ratio: 16/8;">
            <img
              src="/infodogcats au.jpg"
              alt="Kittens and cats for sale in Australia"
              class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-700"
              width="700" height="350"
            />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-md aspect-square bg-warm-white">
            <img
              src={`${SUPABASE_URL}/storage/v1/object/public/cat-images/demo/05-burmese.jpg`}
              alt="Burmese kitten for sale Australia"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              width="350" height="350"
            />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-md aspect-square relative bg-warm-white">
            <img
              src={`${SUPABASE_URL}/storage/v1/object/public/cat-images/demo/08-abyssinian.jpg`}
              alt="Kitten for sale near me Australia"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              width="350" height="350"
            />
            <div class="absolute bottom-3 left-3 right-3 bg-white/92 backdrop-blur-sm rounded-xl px-3 py-2.5 shadow">
              <p class="text-xs font-bold text-gray-900">🐱 26+ cats available now</p>
              <p class="text-xs text-gray-500 mt-0.5">Sydney · Melbourne · Brisbane</p>
            </div>
          </div>
          <div class="absolute -top-3 -right-3 bg-white rounded-2xl px-4 py-3 shadow-lg border border-sand/40">
            <p class="text-xl font-bold text-terracotta font-display">306+</p>
            <p class="text-xs text-gray-500 font-medium">Cat care articles</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- LATEST LISTINGS -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="flex items-end justify-between mb-7">
      <div>
        <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-1">Fresh Listings</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-950">Kittens & Cats for Sale</h2>
      </div>
      <a href="/cats-for-sale" class="flex items-center gap-1 text-terracotta font-semibold text-sm hover:underline">
        View all
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
    {cats && cats.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {cats.map((cat: any) => <CatCard cat={cat} />)}
      </div>
    ) : (
      <div class="text-center py-20 bg-warm-white rounded-3xl border-2 border-dashed border-sand">
        <p class="text-6xl mb-4">🐱</p>
        <p class="font-display text-xl font-bold text-gray-950 mb-2">Be the first to post a listing!</p>
        <p class="text-gray-500 text-sm mb-6">Completely free — takes 2 minutes</p>
        <a href="/post-ad" class="inline-block bg-terracotta text-white px-8 py-3 rounded-xl font-semibold hover:bg-terracotta-light transition-colors">Post Free Ad</a>
      </div>
    )}
  </section>

  <!-- POPULAR BREEDS -->
  <section class="bg-warm-white py-14 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-9">
        <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-2">Browse by Breed</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-950">Popular Breeds in Australia</h2>
        <p class="text-gray-500 text-sm mt-2">Click a breed to find available kittens near you</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
        {breeds.map(breed => (
          <a href={breed.href} class="group bg-white rounded-2xl overflow-hidden border border-gray-100 hover:shadow-lg hover:border-terracotta/30 transition-all">
            <div class="aspect-square overflow-hidden bg-warm-white">
              <img src={breed.img} alt={`${breed.name} kittens for sale in Australia`}
                   class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                   loading="lazy" width="200" height="200" />
            </div>
            <div class="p-3 text-center">
              <p class="text-xs font-bold text-gray-900 group-hover:text-terracotta transition-colors leading-tight">{breed.name}</p>
              <p class="text-xs text-gray-400 leading-tight mt-0.5">{breed.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- NEAR ME CITIES -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="mb-7">
      <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-1">Local Listings</p>
      <h2 class="font-display text-3xl font-bold text-gray-950">Kittens for Sale Near Me</h2>
      <p class="text-gray-500 text-sm mt-1">Find kittens and cats for sale in your city</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {cities.map(loc => (
        <a href={`/cats-for-sale?city=${loc.name.toLowerCase().replace(' ', '-')}&state=${loc.state}`}
           class="group flex items-center gap-3 bg-white border border-gray-100 rounded-2xl px-4 py-4 hover:border-terracotta hover:shadow-md transition-all shadow-sm">
          <div class="w-9 h-9 rounded-xl bg-terracotta/10 flex items-center justify-center flex-shrink-0 group-hover:bg-terracotta/20 transition-colors">
            <svg class="w-4 h-4 text-terracotta" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-900 group-hover:text-terracotta transition-colors leading-tight">Kittens in {loc.name}</p>
            <p class="text-xs text-gray-400">{loc.state}, Australia</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- NEAR ME SERVICES -->
  <section class="bg-warm-white py-14 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="mb-8">
        <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-1">Near Me</p>
        <h2 class="font-display text-3xl font-bold text-gray-950">Find Cat Services Near You</h2>
        <p class="text-gray-500 text-sm mt-1">Vets, groomers, shelters and pet shops across Australia</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        {[
          { href: '/near-me/sydney/cat-vet',     emoji: '🏥', label: 'Cat Vets',  desc: 'Trusted vet clinics',   color: 'bg-red-50 border-red-100 hover:border-red-300' },
          { href: '/near-me/sydney/cat-groomer', emoji: '✂️', label: 'Groomers',  desc: 'Professional grooming', color: 'bg-purple-50 border-purple-100 hover:border-purple-300' },
          { href: '/near-me/sydney/cat-shelter', emoji: '🏠', label: 'Shelters',  desc: 'Adopt a cat',           color: 'bg-blue-50 border-blue-100 hover:border-blue-300' },
          { href: '/near-me/sydney/pet-shop',    emoji: '🛒', label: 'Pet Shops', desc: 'Food & accessories',    color: 'bg-orange-50 border-orange-100 hover:border-orange-300' },
        ].map(item => (
          <a href={item.href}
             class={`group flex flex-col items-center text-center p-5 rounded-2xl border-2 transition-all ${item.color}`}>
            <span class="text-3xl mb-2">{item.emoji}</span>
            <p class="font-bold text-gray-900 text-sm group-hover:text-terracotta transition-colors">{item.label}</p>
            <p class="text-gray-400 text-xs mt-0.5">{item.desc}</p>
          </a>
        ))}
      </div>
      <div class="flex flex-wrap gap-2">
        {['Sydney','Melbourne','Brisbane','Perth','Adelaide','Gold Coast','Canberra','Hobart','Darwin'].map(c => (
          <a href={`/near-me/${c.toLowerCase().replace(' ', '-')}/cat-vet`}
             class="flex items-center gap-1.5 bg-white border border-gray-100 text-gray-600 text-xs font-medium px-3 py-2 rounded-full hover:border-terracotta hover:text-terracotta transition-all shadow-sm">
            <svg class="w-3 h-3 text-terracotta" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            {c}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST BLOG POSTS -->
  {posts && posts.length > 0 && (
    <section class="py-14 px-4">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-end justify-between mb-7">
          <div>
            <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-1">From the Blog</p>
            <h2 class="font-display text-3xl font-bold text-gray-950">Cat Care Tips & Advice</h2>
          </div>
          <a href="/blog" class="flex items-center gap-1 text-terracotta font-semibold text-sm hover:underline">
            All articles
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-5">
          {posts.map((post: any) => (
            <a href={`/${post.slug}`}
               class="group bg-white rounded-2xl overflow-hidden border border-gray-100 hover:shadow-lg transition-all hover:-translate-y-1">
              <div class="overflow-hidden bg-warm-white" style="aspect-ratio: 4/3;">
                {post.featured_image_path ? (
                  <img
                    src={post.featured_image_path.startsWith('http') ? post.featured_image_path : `${SUPABASE_URL}/storage/v1/object/public/cat-images/${post.featured_image_path}`}
                    alt={post.title}
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                    loading="lazy" width="400" height="300" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-warm-white">
                    <svg class="w-10 h-10 text-sand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-4">
                {post.tags?.[0] && (
                  <span class="text-terracotta text-xs font-bold uppercase tracking-wider">{post.tags[0].replace(/-/g, ' ')}</span>
                )}
                <h3 class="font-body font-semibold text-gray-900 text-sm mt-1 mb-1.5 line-clamp-2 group-hover:text-terracotta transition-colors leading-snug">{post.title}</h3>
                <p class="text-gray-400 text-xs line-clamp-2">{post.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- POST AD CTA -->
  <section class="py-14 px-4">
    <div class="max-w-3xl mx-auto bg-charcoal rounded-3xl p-10 text-center relative overflow-hidden">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-10 -right-10 w-60 h-60 bg-terracotta/20 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-terracotta/10 rounded-full blur-2xl"></div>
      </div>
      <div class="relative">
        <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-3">100% Free</p>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-white mb-3">Have a Cat to Rehome?</h2>
        <p class="text-gray-400 mb-6 max-w-md mx-auto text-sm leading-relaxed">
          Post a free listing and reach thousands of cat lovers across Australia. Takes 2 minutes. No fees ever.
        </p>
        <a href="/post-ad" class="inline-block bg-terracotta text-white px-8 py-3.5 rounded-xl font-semibold hover:bg-terracotta-light transition-all shadow-lg hover:-translate-y-0.5 text-sm">
          Post a Free Ad Now →
        </a>
      </div>
    </div>
  </section>

  <!-- SEO TEXT -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-14">
    <div class="bg-warm-white rounded-2xl p-7">
      <h2 class="font-display text-xl font-bold text-gray-950 mb-3">About InfoDogCats Australia</h2>
      <p class="text-gray-500 leading-relaxed text-sm mb-3">
        InfoDogCats is Australia's dedicated free platform for finding kittens and cats for sale. Whether you're searching for kittens in Sydney, cats near Melbourne, Maine Coon kittens in Brisbane, or Ragdoll cats in Perth — we connect you directly with responsible breeders and owners across all Australian states and territories.
      </p>
      <p class="text-gray-500 leading-relaxed text-sm">
        All listings are posted directly by owners. Use our <a href="/near-me/sydney/cat-vet" class="text-terracotta hover:underline font-medium">Near Me</a> feature to find local vets and groomers in your area.
      </p>
    </div>
  </section>

</Layout>