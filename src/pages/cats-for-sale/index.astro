---
export const prerender = false;
import Layout from '../../components/Layout.astro';
import CatCard from '../../components/CatCard.astro';
import { supabase } from '../../lib/supabase';

const url = Astro.url;
const breed = url.searchParams.get('breed') || '';
const state = url.searchParams.get('state') || '';
const city = url.searchParams.get('city') || '';
const q = url.searchParams.get('q') || '';

let query = supabase
  .from('cats')
  .select('id, slug, title, breed, price, city, state, cat_images(storage_path, is_primary)')
  .eq('status', 'active')
  .eq('is_approved', true)
  .order('created_at', { ascending: false })
  .limit(48);

if (state) query = query.eq('state', state.toUpperCase());
if (city) query = query.ilike('city', `%${city}%`);
if (breed) query = query.ilike('breed', `%${breed.replace('-', ' ')}%`);
if (q) query = query.or(`title.ilike.%${q}%,breed.ilike.%${q}%,description.ilike.%${q}%`);

const { data: cats } = await query;

const h1 = breed
  ? `${breed.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())} Kittens for Sale in Australia`
  : state ? `Cats for Sale in ${state.toUpperCase()}, Australia`
  : city ? `Cats for Sale in ${city.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}`
  : 'Cats & Kittens for Sale in Australia';

const desc = `Browse ${cats?.length || 0}+ cats and kittens for sale in Australia. ${breed || 'All breeds'} available. Direct from owners. Updated daily.`;

const isFiltered = !!(state || breed || city || q);
---

<Layout title={h1} description={desc}>

  <!-- Page Header -->
  <div class="bg-warm-white border-b border-sand/30">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-1">
            {isFiltered ? 'Filtered Results' : 'All Listings'}
          </p>
          <h1 class="font-display text-3xl md:text-4xl font-bold text-gray-950">{h1}</h1>
          <p class="text-gray-400 text-sm mt-1">
            {cats?.length || 0} {cats?.length === 1 ? 'listing' : 'listings'} found · Updated daily
          </p>
        </div>
        <a href="/post-ad"
           class="flex-shrink-0 flex items-center gap-2 bg-terracotta text-white px-5 py-2.5 rounded-xl font-semibold text-sm hover:bg-terracotta-light transition-colors shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
          </svg>
          Post Free Ad
        </a>
      </div>

      <!-- Filters -->
      <form method="get" class="flex flex-wrap gap-2.5 mt-5">
        <select name="state"
          class="border border-sand rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 bg-white">
          <option value="">All States</option>
          {['NSW','VIC','QLD','WA','SA','TAS','ACT','NT'].map(s => (
            <option value={s} selected={state.toUpperCase() === s}>{s}</option>
          ))}
        </select>
        <input type="text" name="q" placeholder="Search breed or keyword..." value={q}
          class="border border-sand rounded-xl px-3 py-2.5 text-sm flex-1 min-w-[160px] focus:outline-none focus:ring-2 focus:ring-terracotta/50 bg-white" />
        <button type="submit"
          class="bg-terracotta text-white px-6 py-2.5 rounded-xl text-sm font-semibold hover:bg-terracotta-light transition-colors">
          Search
        </button>
        {isFiltered && (
          <a href="/cats-for-sale"
             class="flex items-center gap-1 text-gray-400 px-3 py-2.5 text-sm hover:text-terracotta transition-colors border border-gray-200 rounded-xl bg-white">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Clear
          </a>
        )}
      </form>
    </div>
  </div>

  <!-- Listings Grid -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    {cats && cats.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {cats.map((cat: any) => <CatCard cat={cat} />)}
      </div>
    ) : (
      <div class="text-center py-20 bg-warm-white rounded-3xl border border-sand/30">
        <p class="text-5xl mb-4">🔍</p>
        <p class="font-display text-xl font-bold text-gray-950 mb-2">No listings found</p>
        <p class="text-gray-400 text-sm mb-5">Try different filters or be the first to post!</p>
        <a href="/post-ad"
           class="inline-block bg-terracotta text-white px-7 py-3 rounded-xl font-semibold hover:bg-terracotta-light transition-colors text-sm">
          Post Free Ad
        </a>
      </div>
    )}

    <!-- CTA -->
    {cats && cats.length > 0 && (
      <div class="mt-12 bg-warm-white border border-sand/30 rounded-2xl p-7 flex flex-col sm:flex-row items-center gap-5 text-center sm:text-left">
        <div class="text-4xl flex-shrink-0">🐱</div>
        <div class="flex-1">
          <h2 class="font-display text-xl font-bold text-gray-950 mb-1">Have a cat to rehome?</h2>
          <p class="text-gray-500 text-sm">Post a free listing and reach thousands of cat lovers across Australia. No fees, ever.</p>
        </div>
        <a href="/post-ad"
           class="flex-shrink-0 bg-terracotta text-white px-7 py-3 rounded-xl font-semibold hover:bg-terracotta-light transition-colors text-sm shadow-sm">
          Post Free Ad →
        </a>
      </div>
    )}
  </div>

</Layout>