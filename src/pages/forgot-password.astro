---
export const prerender = false;
import Layout from '../components/Layout.astro';
---
<Layout title="Forgot Password | InfoDogCats" description="Reset your InfoDogCats account password.">
  <div class="min-h-screen bg-gradient-to-br from-warm-white via-cream to-sand/20 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 mb-4">
          <div class="w-12 h-12 bg-terracotta rounded-2xl flex items-center justify-center shadow-md">
            <span class="text-2xl">🐱</span>
          </div>
          <span class="font-display text-2xl font-bold text-charcoal">InfoDog<span class="text-terracotta">Cats</span></span>
        </a>
        <div class="w-16 h-16 bg-terracotta/10 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-3xl">🔑</span>
        </div>
        <h1 class="font-display text-3xl font-bold text-charcoal">Forgot Password?</h1>
        <p class="text-gray-400 text-sm mt-2 max-w-xs mx-auto">
          No worries! Enter your email and we'll send you a reset link.
        </p>
      </div>

      <div class="bg-white rounded-2xl p-8 border border-sand/30 shadow-sm space-y-4">
        <div>
          <label class="block text-sm font-semibold text-charcoal mb-1.5">Email Address</label>
          <input type="email" id="email" required autocomplete="email"
            placeholder="your@email.com.au"
            class="w-full border border-sand rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/50 transition-all" />
        </div>

        <div id="fp-error" class="hidden bg-red-50 text-red-600 text-xs rounded-xl px-4 py-3 border border-red-200"></div>
        <div id="fp-success" class="hidden bg-green-50 text-green-700 rounded-xl px-5 py-4 border border-green-200 text-center">
          <p class="text-2xl mb-2">📬</p>
          <p class="font-semibold text-sm">Reset link sent!</p>
          <p class="text-xs mt-1 text-green-600">Check your inbox and click the link to reset your password. Check your spam folder if you don't see it.</p>
        </div>

        <button id="fp-btn"
          class="w-full bg-terracotta text-white py-3.5 rounded-xl font-semibold text-sm hover:bg-terracotta-light transition-all shadow-sm disabled:opacity-60">
          Send Reset Link →
        </button>

        <div class="flex items-center justify-center gap-4 text-xs text-gray-400 pt-2">
          <a href="/login" class="hover:text-terracotta transition-colors flex items-center gap-1">
            ← Back to Sign In
          </a>
          <span>·</span>
          <a href="/register" class="hover:text-terracotta transition-colors">Create Account</a>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';
  const sb = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

  document.getElementById('fp-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('fp-btn');
    const err = document.getElementById('fp-error');
    const ok = document.getElementById('fp-success');
    const email = (document.getElementById('email')).value.trim();

    err.classList.add('hidden');

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      err.textContent = 'Please enter a valid email address.';
      err.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Sending...';

    const { error } = await sb.auth.resetPasswordForEmail(email, {
      redirectTo: 'https://www.infodogcats.com/reset-password'
    });

    if (error) {
      err.textContent = error.message;
      err.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Send Reset Link →';
    } else {
      ok.classList.remove('hidden');
      btn.classList.add('hidden');
      document.getElementById('email').disabled = true;
    }
  });
</script>
