---
export const prerender = true;
import Layout from '../components/Layout.astro';
---
<Layout
  title="Contact InfoDogCats | Get in Touch"
  description="Contact the InfoDogCats team. We're here to help Australian cat lovers with listings, general enquiries and feedback."
>
  <!-- Header -->
  <div class="bg-warm-white border-b border-sand/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
      <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-3">Get in Touch</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-gray-950 mb-3">Contact Us</h1>
      <p class="text-gray-500 text-base max-w-xl">
        Have a question about a listing, need help with your account, or want to share feedback? We'd love to hear from you.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid md:grid-cols-5 gap-10">

      <!-- Contact info -->
      <div class="md:col-span-2 space-y-6">

        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
          <div class="w-10 h-10 bg-terracotta/10 rounded-xl flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 text-sm mb-1">Email Us</h3>
          <a href="mailto:info@infodogcats.com" class="text-terracotta text-sm hover:underline font-medium">
            info@infodogcats.com
          </a>
          <p class="text-gray-400 text-xs mt-1">We reply within 24–48 business hours</p>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
          <div class="w-10 h-10 bg-terracotta/10 rounded-xl flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 text-sm mb-1">Based In</h3>
          <p class="text-gray-600 text-sm">Australia</p>
          <p class="text-gray-400 text-xs mt-1">Serving all states & territories</p>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
          <div class="w-10 h-10 bg-terracotta/10 rounded-xl flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 text-sm mb-1">Response Times</h3>
          <p class="text-gray-600 text-sm">Mon–Fri: within 24 hours</p>
          <p class="text-gray-400 text-xs mt-1">Weekends: within 48 hours</p>
        </div>

        <!-- Quick links -->
        <div class="bg-warm-white rounded-2xl p-5 border border-sand/30">
          <h3 class="font-semibold text-gray-900 text-sm mb-3">Quick Links</h3>
          <div class="space-y-2 text-sm">
            <a href="/post-ad" class="flex items-center gap-2 text-terracotta hover:underline">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
              Post a Free Listing
            </a>
            <a href="/privacy-policy" class="flex items-center gap-2 text-terracotta hover:underline">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
              Privacy Policy
            </a>
            <a href="/terms" class="flex items-center gap-2 text-terracotta hover:underline">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
              Terms of Service
            </a>
          </div>
        </div>

      </div>

      <!-- Contact form -->
      <div class="md:col-span-3">
        <div class="bg-white rounded-2xl p-7 border border-gray-100 shadow-sm">
          <h2 class="font-display text-xl font-bold text-gray-950 mb-5">Send Us a Message</h2>

          <div class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">First Name</label>
                <input type="text" id="first-name" placeholder="Sarah"
                  class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/40" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">Last Name</label>
                <input type="text" id="last-name" placeholder="Smith"
                  class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/40" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Email Address <span class="text-terracotta">*</span></label>
              <input type="email" id="email" placeholder="sarah@example.com.au"
                class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/40" />
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Subject <span class="text-terracotta">*</span></label>
              <select id="subject"
                class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/40 text-gray-600">
                <option value="">Select a topic</option>
                <option value="listing">Question about a listing</option>
                <option value="account">Account help</option>
                <option value="report">Report a listing</option>
                <option value="partnership">Partnership / Advertising</option>
                <option value="feedback">General feedback</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Message <span class="text-terracotta">*</span></label>
              <textarea id="message" rows="5"
                placeholder="Tell us how we can help you..."
                class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-terracotta/40 resize-none"></textarea>
            </div>

            <div id="contact-error" class="hidden bg-red-50 text-red-600 text-xs rounded-xl px-4 py-3 border border-red-200"></div>
            <div id="contact-success" class="hidden bg-green-50 text-green-700 text-sm rounded-xl px-4 py-4 border border-green-200 text-center">
              <p class="text-2xl mb-1">✅</p>
              <p class="font-semibold">Message sent!</p>
              <p class="text-xs mt-1 text-green-600">We'll get back to you within 24–48 hours.</p>
            </div>

            <button id="send-btn"
              class="w-full bg-terracotta text-white py-3.5 rounded-xl font-semibold text-sm hover:bg-terracotta-light transition-all shadow-sm">
              Send Message →
            </button>

            <p class="text-xs text-gray-400 text-center">
              Or email us directly at <a href="mailto:info@infodogcats.com" class="text-terracotta hover:underline">info@infodogcats.com</a>
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  document.getElementById('send-btn')?.addEventListener('click', () => {
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const subject = (document.getElementById('subject') as HTMLSelectElement).value;
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();
    const err = document.getElementById('contact-error')!;
    const ok = document.getElementById('contact-success')!;
    const btn = document.getElementById('send-btn') as HTMLButtonElement;

    err.classList.add('hidden');

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      err.textContent = 'Please enter a valid email address.';
      err.classList.remove('hidden');
      return;
    }
    if (!subject) {
      err.textContent = 'Please select a subject.';
      err.classList.remove('hidden');
      return;
    }
    if (!message || message.length < 10) {
      err.textContent = 'Please write a message (at least 10 characters).';
      err.classList.remove('hidden');
      return;
    }

    // Simulate send (replace with real email service like EmailJS or Resend)
    btn.disabled = true;
    btn.textContent = 'Sending...';

    setTimeout(() => {
      ok.classList.remove('hidden');
      btn.classList.add('hidden');
    }, 800);
  });
</script>
