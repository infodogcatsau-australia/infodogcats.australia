---
export const prerender = false;
import Layout from '../../components/Layout.astro';
import CatCard from '../../components/CatCard.astro';
import { supabase } from '../../lib/supabase';
import { buildLocalBusinessSchema } from '../../lib/seo';

const { city } = Astro.params;
const cityName = city ? city.charAt(0).toUpperCase() + city.slice(1).replace(/-/g, ' ') : 'Sydney';

const [{ data: services }, { data: cats }] = await Promise.all([
  supabase.from('local_services').select('*').ilike('city', `%${cityName}%`).eq('is_active', true).order('rating', { ascending: false }).limit(60),
  supabase.from('cats').select('id, slug, title, breed, price, city, state, cat_images(storage_path, is_primary)').eq('status', 'active').eq('is_approved', true).ilike('city', `%${cityName}%`).order('created_at', { ascending: false }).limit(6),
]);

Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800');

const vets     = (services || []).filter((s: any) => s.category === 'vet');
const groomers = (services || []).filter((s: any) => s.category === 'groomer');
const shelters = (services || []).filter((s: any) => s.category === 'shelter');
const petShops = (services || []).filter((s: any) => s.category === 'pet_shop');

const schemas = vets.slice(0, 5).map((s: any) => buildLocalBusinessSchema(s));
const auCities = ['Sydney','Melbourne','Brisbane','Perth','Adelaide','Gold Coast','Canberra','Hobart','Darwin'];

const categoryCards = [
  { href: `/near-me/${city}/cat-vet`,     emoji: '🏥', label: 'Cat Vets',     count: vets.length,     color: 'bg-red-50 border-red-100 hover:border-red-300 text-red-600' },
  { href: `/near-me/${city}/cat-groomer`, emoji: '✂️', label: 'Groomers',     count: groomers.length, color: 'bg-purple-50 border-purple-100 hover:border-purple-300 text-purple-600' },
  { href: `/near-me/${city}/cat-shelter`, emoji: '🏠', label: 'Shelters',     count: shelters.length, color: 'bg-blue-50 border-blue-100 hover:border-blue-300 text-blue-600' },
  { href: `/near-me/${city}/pet-shop`,    emoji: '🛒', label: 'Pet Shops',    count: petShops.length, color: 'bg-orange-50 border-orange-100 hover:border-orange-300 text-orange-600' },
];
---

<Layout
  title={`Cat Vets & Services Near Me in ${cityName} | InfoDogCats`}
  description={`Find trusted cat vets, groomers, shelters and pet shops near you in ${cityName}, Australia. Plus cats and kittens for sale in ${cityName}. Updated 2026.`}
  schema={schemas.length > 0 ? schemas : undefined}
>

  <!-- Header -->
  <div class="bg-warm-white border-b border-sand/30">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <nav class="text-xs text-gray-400 mb-4 flex items-center gap-2 flex-wrap">
        <a href="/" class="hover:text-terracotta">Home</a>
        <span>/</span>
        <span>Near Me</span>
        <span>/</span>
        <span class="text-gray-600 font-medium">{cityName}</span>
      </nav>
      <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-2">Near Me</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-gray-950 mb-3">
        Cat Services in {cityName}
      </h1>
      <p class="text-gray-500 text-base max-w-2xl mb-6">
        Find trusted cat vets, groomers, shelters and pet shops near you in {cityName}, {services?.[0]?.state || 'Australia'}. Plus local cats for sale.
      </p>

      <!-- Category cards with links -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
        {categoryCards.map(card => (
          <a href={card.href}
             class={`group flex flex-col items-center text-center p-4 rounded-2xl border-2 transition-all ${card.color}`}>
            <span class="text-2xl mb-1.5">{card.emoji}</span>
            <p class="font-bold text-gray-900 text-xs group-hover:text-terracotta transition-colors">{card.label}</p>
            {card.count > 0 && (
              <p class="text-xs mt-0.5 opacity-70">{card.count} found</p>
            )}
          </a>
        ))}
      </div>

      <!-- City selector -->
      <div class="flex flex-wrap gap-2">
        {auCities.map(c => (
          <a href={`/near-me/${c.toLowerCase().replace(' ', '-')}`}
             class={`px-4 py-1.5 rounded-full text-xs font-semibold border transition-all ${c === cityName ? 'bg-terracotta text-white border-terracotta' : 'bg-white border-gray-200 text-gray-600 hover:border-terracotta hover:text-terracotta'}`}>
            {c}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-14">

    <!-- LOCAL CATS -->
    {cats && cats.length > 0 && (
      <section>
        <div class="flex items-end justify-between mb-6">
          <div>
            <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-1">Local Listings</p>
            <h2 class="font-display text-2xl font-bold text-gray-950">Cats for Sale in {cityName}</h2>
          </div>
          <a href={`/cats-for-sale?city=${city}`} class="text-terracotta font-semibold text-sm hover:underline flex items-center gap-1">
            View all
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {cats.map((cat: any) => <CatCard cat={cat} />)}
        </div>
      </section>
    )}

    <!-- VETS preview -->
    {vets.length > 0 && (
      <section>
        <div class="flex items-end justify-between mb-5">
          <div>
            <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-1">Healthcare</p>
            <h2 class="font-display text-2xl font-bold text-gray-950">Cat Vets Near Me in {cityName}</h2>
            <p class="text-gray-400 text-sm mt-1">{vets.length} veterinary clinics</p>
          </div>
          <a href={`/near-me/${city}/cat-vet`} class="flex items-center gap-1 text-terracotta font-semibold text-sm hover:underline">
            View all {vets.length}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {vets.slice(0, 6).map((s: any) => (
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-all group">
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1 min-w-0">
                  <span class="text-xs font-bold uppercase tracking-wider text-terracotta block mb-1">🏥 Veterinary Clinic</span>
                  <h3 class="font-semibold text-gray-900 text-sm leading-tight">{s.name}</h3>
                </div>
                {s.rating && <span class="ml-2 flex-shrink-0 bg-green-50 text-green-700 text-xs font-bold px-2 py-1 rounded-full border border-green-200">⭐ {s.rating}</span>}
              </div>
              {s.address && <p class="text-gray-400 text-xs mb-1 flex items-center gap-1"><svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>{s.address}</p>}
              {s.phone && <a href={`tel:${s.phone}`} class="text-gray-500 text-xs flex items-center gap-1 hover:text-terracotta transition-colors mb-2"><svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>{s.phone}</a>}
              {s.website && <a href={s.website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-terracotta text-xs font-medium hover:underline mt-1">Visit website <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg></a>}
            </div>
          ))}
        </div>
        {vets.length > 6 && (
          <div class="mt-5 text-center">
            <a href={`/near-me/${city}/cat-vet`}
               class="inline-flex items-center gap-2 bg-white border border-terracotta text-terracotta px-6 py-2.5 rounded-xl font-semibold text-sm hover:bg-terracotta hover:text-white transition-all">
              View all {vets.length} cat vets in {cityName} →
            </a>
          </div>
        )}
      </section>
    )}

    <!-- GROOMERS preview -->
    {groomers.length > 0 && (
      <section>
        <div class="flex items-end justify-between mb-5">
          <div>
            <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-1">Grooming</p>
            <h2 class="font-display text-2xl font-bold text-gray-950">Cat Groomers Near {cityName}</h2>
            <p class="text-gray-400 text-sm mt-1">{groomers.length} groomers</p>
          </div>
          <a href={`/near-me/${city}/cat-groomer`} class="flex items-center gap-1 text-terracotta font-semibold text-sm hover:underline">
            View all {groomers.length}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {groomers.slice(0, 3).map((s: any) => (
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-all">
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1 min-w-0">
                  <span class="text-xs font-bold uppercase tracking-wider text-purple-600 block mb-1">✂️ Groomer</span>
                  <h3 class="font-semibold text-gray-900 text-sm leading-tight">{s.name}</h3>
                </div>
                {s.rating && <span class="ml-2 flex-shrink-0 bg-purple-50 text-purple-700 text-xs font-bold px-2 py-1 rounded-full border border-purple-200">⭐ {s.rating}</span>}
              </div>
              {s.address && <p class="text-gray-400 text-xs mb-1">📍 {s.address}</p>}
              {s.phone && <a href={`tel:${s.phone}`} class="text-gray-500 text-xs hover:text-terracotta block mb-2">📞 {s.phone}</a>}
              {s.website && <a href={s.website} target="_blank" rel="noopener noreferrer" class="text-terracotta text-xs font-medium hover:underline">Visit website →</a>}
            </div>
          ))}
        </div>
        {groomers.length > 3 && (
          <div class="mt-5 text-center">
            <a href={`/near-me/${city}/cat-groomer`}
               class="inline-flex items-center gap-2 bg-white border border-purple-300 text-purple-600 px-6 py-2.5 rounded-xl font-semibold text-sm hover:bg-purple-600 hover:text-white transition-all">
              View all {groomers.length} groomers in {cityName} →
            </a>
          </div>
        )}
      </section>
    )}

    <!-- SHELTERS preview -->
    {shelters.length > 0 && (
      <section>
        <div class="flex items-end justify-between mb-5">
          <div>
            <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-1">Adoption</p>
            <h2 class="font-display text-2xl font-bold text-gray-950">Cat Shelters & Rescues in {cityName}</h2>
            <p class="text-gray-400 text-sm mt-1">{shelters.length} shelters</p>
          </div>
          <a href={`/near-me/${city}/cat-shelter`} class="flex items-center gap-1 text-terracotta font-semibold text-sm hover:underline">
            View all {shelters.length}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {shelters.slice(0, 3).map((s: any) => (
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-all">
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1 min-w-0">
                  <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">🏠 Shelter</span>
                  <h3 class="font-semibold text-gray-900 text-sm leading-tight">{s.name}</h3>
                </div>
                {s.rating && <span class="ml-2 flex-shrink-0 bg-blue-50 text-blue-700 text-xs font-bold px-2 py-1 rounded-full border border-blue-200">⭐ {s.rating}</span>}
              </div>
              {s.address && <p class="text-gray-400 text-xs mb-1">📍 {s.address}</p>}
              {s.phone && <a href={`tel:${s.phone}`} class="text-gray-500 text-xs hover:text-terracotta block mb-2">📞 {s.phone}</a>}
              {s.website && <a href={s.website} target="_blank" rel="noopener noreferrer" class="text-terracotta text-xs font-medium hover:underline">Visit website →</a>}
            </div>
          ))}
        </div>
        {shelters.length > 3 && (
          <div class="mt-5 text-center">
            <a href={`/near-me/${city}/cat-shelter`}
               class="inline-flex items-center gap-2 bg-white border border-blue-300 text-blue-600 px-6 py-2.5 rounded-xl font-semibold text-sm hover:bg-blue-600 hover:text-white transition-all">
              View all {shelters.length} shelters in {cityName} →
            </a>
          </div>
        )}
      </section>
    )}

    <!-- PET SHOPS preview -->
    {petShops.length > 0 && (
      <section>
        <div class="flex items-end justify-between mb-5">
          <div>
            <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-1">Shopping</p>
            <h2 class="font-display text-2xl font-bold text-gray-950">Pet Shops in {cityName}</h2>
            <p class="text-gray-400 text-sm mt-1">{petShops.length} pet shops</p>
          </div>
          <a href={`/near-me/${city}/pet-shop`} class="flex items-center gap-1 text-terracotta font-semibold text-sm hover:underline">
            View all {petShops.length}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {petShops.slice(0, 3).map((s: any) => (
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-all">
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1 min-w-0">
                  <span class="text-xs font-bold uppercase tracking-wider text-orange-600 block mb-1">🛒 Pet Shop</span>
                  <h3 class="font-semibold text-gray-900 text-sm leading-tight">{s.name}</h3>
                </div>
                {s.rating && <span class="ml-2 flex-shrink-0 bg-orange-50 text-orange-700 text-xs font-bold px-2 py-1 rounded-full border border-orange-200">⭐ {s.rating}</span>}
              </div>
              {s.address && <p class="text-gray-400 text-xs mb-1">📍 {s.address}</p>}
              {s.phone && <a href={`tel:${s.phone}`} class="text-gray-500 text-xs hover:text-terracotta block mb-2">📞 {s.phone}</a>}
              {s.website && <a href={s.website} target="_blank" rel="noopener noreferrer" class="text-terracotta text-xs font-medium hover:underline">Visit website →</a>}
            </div>
          ))}
        </div>
        {petShops.length > 3 && (
          <div class="mt-5 text-center">
            <a href={`/near-me/${city}/pet-shop`}
               class="inline-flex items-center gap-2 bg-white border border-orange-300 text-orange-600 px-6 py-2.5 rounded-xl font-semibold text-sm hover:bg-orange-600 hover:text-white transition-all">
              View all {petShops.length} pet shops in {cityName} →
            </a>
          </div>
        )}
      </section>
    )}

    <!-- Empty state -->
    {(!services || services.length === 0) && (!cats || cats.length === 0) && (
      <div class="text-center py-20 bg-warm-white rounded-3xl border border-sand/30">
        <p class="text-6xl mb-4">📍</p>
        <p class="font-display text-xl font-bold text-gray-950 mb-2">Nothing listed in {cityName} yet</p>
        <p class="text-gray-400 text-sm mb-6">Be the first to post a listing in this area!</p>
        <a href="/post-ad" class="bg-terracotta text-white px-8 py-3 rounded-full font-semibold hover:bg-terracotta-light transition-colors inline-block text-sm">Post Free Ad</a>
      </div>
    )}

    <!-- SEO Text -->
    <section class="bg-warm-white rounded-2xl p-7 border border-sand/30">
      <h2 class="font-display text-xl font-bold text-gray-950 mb-3">Finding Cat Services Near You in {cityName}</h2>
      <p class="text-gray-500 text-sm leading-relaxed mb-3">
        InfoDogCats is your local guide to cat services in {cityName}, Australia. Whether you need a trusted cat vet for your kitten's first check-up, a professional groomer for your Persian or Maine Coon, or you're looking to adopt from a local shelter — we've got you covered.
      </p>
      <p class="text-gray-500 text-sm leading-relaxed">
        We also list cats and kittens for sale in {cityName} directly from local breeders and owners. Browse our <a href={`/cats-for-sale?city=${city}`} class="text-terracotta hover:underline font-medium">cats for sale in {cityName}</a> or post your own free listing today.
      </p>
    </section>

  </div>
</Layout>