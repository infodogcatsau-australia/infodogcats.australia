---
import { createSupabaseServerClient } from '../../../../lib/supabase';
import Layout from '../../../../components/Layout.astro';
import SEOMeta from '../../../../components/SEOMeta.astro';

export const prerender = false;

const { city, category, slug } = Astro.params;

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

const { data: service, error } = await supabase
  .from('local_services')
  .select('*')
  .eq('slug', slug)
  .eq('is_active', true)
  .single();

if (error || !service) {
  return Astro.redirect('/404');
}

const { data: nearby } = await supabase
  .from('local_services')
  .select('id, name, slug, address, rating, phone')
  .eq('category', service.category)
  .eq('city', service.city)
  .eq('is_active', true)
  .neq('slug', slug)
  .limit(6);

const categoryLabels: Record<string, { singular: string; plural: string; icon: string; nearme: string }> = {
  vet:      { singular: 'Veterinary Clinic', plural: 'Vets',      icon: '🏥', nearme: 'Cat Vet Near Me' },
  groomer:  { singular: 'Pet Groomer',       plural: 'Groomers',  icon: '✂️', nearme: 'Cat Groomer Near Me' },
  shelter:  { singular: 'Animal Shelter',    plural: 'Shelters',  icon: '🏠', nearme: 'Cat Shelter Near Me' },
  breeder:  { singular: 'Cat Breeder',       plural: 'Breeders',  icon: '🐱', nearme: 'Cat Breeder Near Me' },
  pet_shop: { singular: 'Pet Shop',          plural: 'Pet Shops', icon: '🛒', nearme: 'Pet Shop Near Me' },
};

const cat = categoryLabels[service.category] ?? { singular: service.category, plural: service.category, icon: '📍', nearme: 'Service Near Me' };
const cityFormatted = service.city.charAt(0).toUpperCase() + service.city.slice(1);
const stateFormatted = service.state.toUpperCase();
const categorySlug = service.category.replace('_', '-');

function hashSlug(s: string): number {
  let h = 0;
  for (const c of s) h = (h * 31 + c.charCodeAt(0)) & 0xffff;
  return h % 4;
}
const v = hashSlug(slug!);

