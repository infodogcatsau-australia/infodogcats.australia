const faqs = (faqSets[service.category] ?? faqSets['vet'])[v];

const hasCoords = service.latitude && service.longitude;
const mapsQuery = encodeURIComponent(`${service.name} ${service.address ?? ''} ${cityFormatted}`);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const mapsDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${mapsQuery}`;
const embedUrl = hasCoords
  ? `https://maps.google.com/maps?q=${service.latitude},${service.longitude}&z=15&output=embed`
  : `https://maps.google.com/maps?q=${mapsQuery}&z=15&output=embed`;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Near Me', href: '/near-me' },
  { label: cityFormatted, href: `/near-me/${service.city.toLowerCase()}` },
  { label: cat.plural, href: `/near-me/${service.city.toLowerCase()}/${categorySlug}` },
  { label: service.name, href: '#' },
];

const pageTitle = `${service.name} — ${cat.singular} in ${cityFormatted}, ${stateFormatted} | InfoDogCats`;
const pageDescription = `Looking for a ${cat.nearme} in ${cityFormatted}? ${service.name} is a local ${cat.singular.toLowerCase()} in ${cityFormatted}, ${stateFormatted}. View contact details, location map, and more.`;
const canonicalUrl = `https://www.infodogcats.com/near-me/${service.city.toLowerCase()}/${categorySlug}/${service.slug}`;

const schema = {
  "@context": "https://schema.org",
  "@type": service.category === 'vet' ? "VeterinaryCare" : "LocalBusiness",
  "name": service.name,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": service.address ?? '',
    "addressLocality": cityFormatted,
    "addressRegion": stateFormatted,
    "postalCode": service.postcode ?? '',
    "addressCountry": "AU"
  },
  ...(service.phone    ? { "telephone": service.phone } : {}),
  ...(service.website  ? { "url": service.website }     : {}),
  ...(service.rating   ? { "aggregateRating": { "@type": "AggregateRating", "ratingValue": service.rating, "bestRating": 5 } } : {}),
  ...(hasCoords        ? { "geo": { "@type": "GeoCoordinates", "latitude": service.latitude, "longitude": service.longitude } } : {}),
  "areaServed": cityFormatted,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<Layout title={pageTitle}>
  <SEOMeta title={pageTitle} description={pageDescription} canonical={canonicalUrl} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <main class="min-h-screen bg-[#FDFAF5]">

    <!-- Breadcrumb -->
    <nav class="bg-[#F8F4ED] border-b border-[#D4B896]/30 py-3" aria-label="Breadcrumb">
      <div class="max-w-6xl mx-auto px-4">
        <ol class="flex flex-wrap items-center gap-1 text-sm text-[#2C2C2C]/60">
          {breadcrumbs.map((crumb, i) => (
            <li class="flex items-center gap-1">
              {i > 0 && <span class="text-[#D4B896]">›</span>}
              {crumb.href === '#'
                ? <span class="text-[#2C2C2C] font-medium truncate max-w-[200px]">{crumb.label}</span>
                : <a href={crumb.href} class="hover:text-[#C85A3C] transition-colors">{crumb.label}</a>
              }
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <!-- Hero banner -->
    <div class="bg-gradient-to-br from-[#C85A3C] to-[#a04830] text-white">
      <div class="max-w-6xl mx-auto px-4 py-8 lg:py-10">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="bg-white/20 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-widest">
                {cat.icon} {cat.nearme}
              </span>
            </div>
            <h1 class="text-3xl lg:text-4xl font-bold leading-tight font-['Playfair_Display',serif] mb-1">
              {service.name}
            </h1>
            <p class="text-white/80 text-sm">{cat.singular} · {cityFormatted}, {stateFormatted}</p>
            {service.rating && (
              <div class="flex items-center gap-2 mt-3">
                <div class="flex">
                  {Array.from({length: 5}).map((_, i) => (
                    <svg class={`w-4 h-4 ${i < Math.round(service.rating) ? 'text-amber-300' : 'text-white/30'}`} fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  ))}
                </div>
                <span class="text-sm font-semibold">{service.rating.toFixed(1)} / 5.0</span>
              </div>
            )}
          </div>
          <div class="flex flex-wrap gap-2 mt-1">
            {service.phone && (
              <a href={`tel:${service.phone}`}
                 class="flex items-center gap-2 bg-white text-[#C85A3C] font-bold text-sm px-5 py-2.5 rounded-xl hover:bg-[#FFF8F5] transition-colors shadow">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                </svg>
                Call Now
              </a>
            )}
            <a href={mapsDirectionsUrl} target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 bg-white/15 border border-white/30 text-white font-semibold text-sm px-5 py-2.5 rounded-xl hover:bg-white/25 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
              Directions
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Info strip -->
    <div class="bg-white border-b border-[#D4B896]/30 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 py-4">
        <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
          {service.address && (
            <div class="flex items-center gap-2 text-[#2C2C2C]">
              <svg class="w-4 h-4 text-[#C85A3C] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>{service.address}, {cityFormatted} {service.postcode ?? ''}</span>
            </div>
          )}
          {service.phone && (
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#C85A3C] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z"/>
              </svg>
              <a href={`tel:${service.phone}`} class="text-[#C85A3C] font-semibold hover:underline">{service.phone}</a>
            </div>
          )}
          {service.website && (
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#C85A3C] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/>
              </svg>
              <a href={service.website} target="_blank" rel="noopener noreferrer" class="text-[#C85A3C] font-semibold hover:underline">Visit Website</a>
            </div>
          )}
          {service.rating && (
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              <span class="font-semibold text-[#2C2C2C]">{service.rating.toFixed(1)}</span>
              <span class="text-[#2C2C2C]/50">/ 5.0</span>
            </div>
          )}
        </div>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 py-8 lg:py-10">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">

        <!-- Main content (3/4) -->
        <div class="lg:col-span-3 space-y-10">

          <!-- Map -->
          <section>
            <h2 class="text-lg font-bold text-[#2C2C2C] mb-3 font-['Playfair_Display',serif]">
              Location — {service.name} in {cityFormatted}
            </h2>
            <div class="rounded-2xl overflow-hidden border border-[#D4B896]/40 shadow-sm">
              <iframe
                src={embedUrl}
                width="100%"
                height="320"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`Map showing location of ${service.name} in ${cityFormatted}`}
              ></iframe>
            </div>
            <div class="flex gap-3 mt-3">
              <a href={mapsDirectionsUrl} target="_blank" rel="noopener noreferrer"
                 class="flex items-center gap-2 px-4 py-2 bg-[#2D5016] text-white text-sm font-semibold rounded-xl hover:bg-[#244010] transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                </svg>
                Get Directions
              </a>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer"
                 class="flex items-center gap-2 px-4 py-2 bg-white border border-[#D4B896]/60 text-[#2C2C2C] text-sm font-medium rounded-xl hover:bg-[#F8F4ED] transition-colors">
                <svg class="w-4 h-4 text-[#C85A3C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                </svg>
                View on Google Maps
              </a>
            </div>
          </section>

          <!-- About -->
          <section>
            <h2 class="text-xl font-bold text-[#2C2C2C] mb-4 font-['Playfair_Display',serif]">
              About {service.name}
            </h2>
            <div class="space-y-4">
              {paragraphs.map(p => (
                <p class="text-[#2C2C2C]/80 leading-relaxed">{p}</p>
              ))}
            </div>
          </section>

          <!-- FAQ -->
          <section>
            <h2 class="text-xl font-bold text-[#2C2C2C] mb-4 font-['Playfair_Display',serif]">
              Frequently Asked Questions — {cat.nearme} in {cityFormatted}
            </h2>
            <div class="space-y-3">
              {faqs.map((faq) => (
                <details class="group bg-white border border-[#D4B896]/40 rounded-xl overflow-hidden">
                  <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none hover:bg-[#F8F4ED] transition-colors">
                    <span class="font-medium text-[#2C2C2C] pr-4 text-sm">{faq.q}</span>
                    <svg class="w-5 h-5 text-[#C85A3C] flex-shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                  </summary>
                  <div class="px-5 pb-4 pt-2 text-[#2C2C2C]/75 text-sm leading-relaxed border-t border-[#D4B896]/30">
                    {faq.a}
                  </div>
                </details>
              ))}
            </div>
          </section>

          <!-- Nearby services -->
          {nearby && nearby.length > 0 && (
            <section>
              <h2 class="text-xl font-bold text-[#2C2C2C] mb-4 font-['Playfair_Display',serif]">
                Other {cat.plural} Near You in {cityFormatted}
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {nearby.map(n => (
                  <a href={`/near-me/${service.city.toLowerCase()}/${categorySlug}/${n.slug}`}
                     class="flex items-start gap-3 p-4 bg-white border border-[#D4B896]/40 rounded-xl hover:border-[#C85A3C]/50 hover:bg-[#FFF8F5] transition-all group">
                    <span class="text-xl mt-0.5 flex-shrink-0">{cat.icon}</span>
                    <div class="min-w-0">
                      <p class="font-medium text-[#2C2C2C] group-hover:text-[#C85A3C] transition-colors truncate text-sm">{n.name}</p>
                      {n.address && <p class="text-xs text-[#2C2C2C]/50 mt-0.5 truncate">{n.address}</p>}
                      {n.rating && <p class="text-xs text-amber-500 mt-1">★ {n.rating.toFixed(1)}</p>}
                    </div>
                  </a>
                ))}
              </div>
              <a href={`/near-me/${service.city.toLowerCase()}/${categorySlug}`}
                 class="inline-flex items-center gap-1.5 mt-4 text-sm text-[#C85A3C] hover:underline font-semibold">
                View all {cat.plural} in {cityFormatted}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </section>
          )}

        </div>

        <!-- Sidebar (1/4) -->
        <aside class="space-y-6">

          <!-- Contact card -->
          <div class="bg-white border border-[#D4B896]/40 rounded-2xl overflow-hidden">
            <div class="bg-[#C85A3C] px-4 py-3">
              <h3 class="text-white font-semibold text-xs uppercase tracking-widest">Contact</h3>
            </div>
            <div class="p-4 space-y-3">
              {service.address && (
                <div class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-[#C85A3C] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <div>
                    <p class="text-xs text-[#2C2C2C] leading-snug">{service.address}</p>
                    <p class="text-xs text-[#2C2C2C]/60">{cityFormatted}, {stateFormatted}{service.postcode ? ' ' + service.postcode : ''}</p>
                  </div>
                </div>
              )}
              {service.phone && (
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#C85A3C] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z"/>
                  </svg>
                  <a href={`tel:${service.phone}`} class="text-xs font-semibold text-[#C85A3C] hover:underline">{service.phone}</a>
                </div>
              )}
              {service.website && (
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#C85A3C] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/>
                  </svg>
                  <a href={service.website} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[#C85A3C] hover:underline truncate">Visit Website</a>
                </div>
              )}
              {service.rating && (
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  <span class="text-xs font-semibold text-[#2C2C2C]">{service.rating.toFixed(1)} / 5.0</span>
                </div>
              )}
              <div class="pt-1 space-y-2">
                {service.phone && (
                  <a href={`tel:${service.phone}`}
                     class="flex items-center justify-center gap-2 w-full py-2.5 bg-[#C85A3C] hover:bg-[#b04e34] text-white font-semibold text-sm rounded-xl transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z"/>
                    </svg>
                    Call Now
                  </a>
                )}
                <a href={mapsDirectionsUrl} target="_blank" rel="noopener noreferrer"
                   class="flex items-center justify-center gap-2 w-full py-2.5 bg-[#2D5016] hover:bg-[#244010] text-white font-semibold text-sm rounded-xl transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                  </svg>
                  Get Directions
                </a>
              </div>
            </div>
          </div>

          <!-- Ad slot 1 -->
          <div class="rounded-2xl overflow-hidden">
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="ca-pub-6105386470374334"
                 data-ad-slot="9810754441"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
          </div>

          <!-- Back link -->
          <a href={`/near-me/${service.city.toLowerCase()}/${categorySlug}`}
             class="flex items-center gap-2 text-sm text-[#C85A3C] hover:underline font-medium">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            All {cat.plural} in {cityFormatted}
          </a>

          <!-- Ad slot 2 -->
          <div class="rounded-2xl overflow-hidden">
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="ca-pub-6105386470374334"
                 data-ad-slot="4865549528"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
          </div>

        </aside>
      </div>
    </div>
  </main>
</Layout>