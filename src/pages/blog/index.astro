---
export const prerender = false;
import Layout from '../../components/Layout.astro';
import { supabase } from '../../lib/supabase';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;

const { data: posts } = await supabase
  .from('posts')
  .select('id, slug, title, excerpt, tags, featured_image_path, published_at, author')
  .eq('is_published', true)
  .order('published_at', { ascending: false })
  .range(0, 299);

const tagLabels: Record<string, string> = {
  'maine-coon': 'Maine Coon',
  'cat-breeds': 'Cat Breeds',
  'cat-health': 'Cat Health',
  'cat-food': 'Cat Food',
  'indoor-cats': 'Indoor Cat Life',
  'cats-for-adoption': 'Adoption',
  'rescue': 'Rescue',
  'feral-cats': 'Feral Cats',
  'ragdoll': 'Ragdoll',
  'burmese-cat': 'Burmese',
  'sphynx-cat': 'Sphynx',
  'kittens': 'Kittens',
  'cats-for-sale': 'Cats for Sale',
  'cats': 'Cats',
  'pets': 'Pets',
  'dog-food': 'Dog Food',
};

function tagLabel(tag: string): string {
  return tagLabels[tag] || tag.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
}

function blogImgUrl(path: string): string {
  if (!path) return '';
  if (path.startsWith('http')) return path;
  return `${SUPABASE_URL}/storage/v1/object/public/cat-images/${path}`;
}


const tagColors: Record<string, string> = {
  'maine-coon': 'bg-amber-50 text-amber-700 border-amber-200',
  'cat-breeds': 'bg-purple-50 text-purple-700 border-purple-200',
  'cat-health': 'bg-green-50 text-green-700 border-green-200',
  'cat-food': 'bg-orange-50 text-orange-700 border-orange-200',
  'indoor-cats': 'bg-blue-50 text-blue-700 border-blue-200',
  'feral-cats': 'bg-gray-50 text-gray-700 border-gray-200',
  'ragdoll': 'bg-pink-50 text-pink-700 border-pink-200',
  'burmese-cat': 'bg-yellow-50 text-yellow-700 border-yellow-200',
  'sphynx-cat': 'bg-indigo-50 text-indigo-700 border-indigo-200',
};

function tagColor(tag: string): string {
  return tagColors[tag] || 'bg-terracotta/10 text-terracotta border-terracotta/20';
}

const allTags = [...new Set((posts || []).flatMap((p: any) => p.tags || []))].slice(0, 10);
---

<Layout
  title="Cat Care Blog & Advice | InfoDogCats Australia"
  description="Expert cat care tips, breed guides, health advice, and kitten care articles for Australian cat owners. Browse 306+ articles."
>

  <!-- Blog Header -->
  <div class="bg-warm-white border-b border-sand/30">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <div class="max-w-2xl">
        <p class="text-terracotta text-xs font-bold uppercase tracking-widest mb-2">Expert Advice</p>
        <h1 class="font-display text-4xl md:text-5xl font-bold text-gray-950 mb-3">Cat Care Blog</h1>
        <p class="text-gray-500 text-base">Breed guides, health tips, food advice and care articles for Australian cat owners.</p>
      </div>
      {allTags.length > 0 && (
        <div class="flex gap-2 flex-wrap mt-6">
          <a href="/blog" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-terracotta text-white border border-terracotta">
            All
          </a>
          {allTags.map((tag: string) => (
            <a href={`/blog/tag/${tag}`}
               class={`px-3 py-1.5 rounded-full text-xs font-semibold border transition-all hover:shadow-sm ${tagColor(tag)}`}>
              {tagLabel(tag)}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>

  <!-- Blog Grid -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    {posts && posts.length > 0 ? (
      <>
        <!-- Featured post -->
        <div class="mb-8">
          <a href={`/${posts[0].slug}`}
             class="group grid md:grid-cols-2 gap-0 bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-sand/20">
            <div class="aspect-[16/10] md:aspect-auto overflow-hidden bg-warm-white">
              {posts[0].featured_image_path ? (
                <img
                  src={blogImgUrl(posts[0].featured_image_path)}
                  alt={posts[0].title}
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700"
                  loading="eager" width="700" height="438"
                />
              ) : (
                <div class="w-full h-full min-h-[250px] flex items-center justify-center bg-warm-white text-6xl">🐱</div>
              )}
            </div>
            <div class="p-7 flex flex-col justify-center">
              {posts[0].tags?.[0] && (
                <span class={`inline-flex self-start px-3 py-1 rounded-full text-xs font-bold border mb-3 ${tagColor(posts[0].tags[0])}`}>
                  {tagLabel(posts[0].tags[0])}
                </span>
              )}
              <h2 class="font-body font-bold text-gray-950 text-xl md:text-2xl leading-snug mb-3 group-hover:text-terracotta transition-colors">
                {posts[0].title}
              </h2>
              {posts[0].excerpt && (
                <p class="text-gray-500 text-sm leading-relaxed mb-4 line-clamp-3">{posts[0].excerpt}</p>
              )}
              <div class="flex items-center gap-2 text-xs text-gray-400 mt-auto">
                <div class="w-6 h-6 bg-terracotta rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                  {(posts[0].author || 'I').charAt(0).toUpperCase()}
                </div>
                <span class="font-medium text-gray-600">{posts[0].author}</span>
                {posts[0].published_at && (
                  <>
                    <span>·</span>
                    <span>{new Date(posts[0].published_at).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                  </>
                )}
              </div>
              <div class="mt-4">
                <span class="inline-flex items-center gap-1 text-terracotta font-semibold text-sm">
                  Read article
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {posts.slice(1).map((post: any) => (
            <a href={`/${post.slug}`}
               class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1 border border-sand/20 flex flex-col">
              <div class="overflow-hidden bg-warm-white" style="aspect-ratio: 16/9;">
                {post.featured_image_path ? (
                  <img
                    src={blogImgUrl(post.featured_image_path)}
                    alt={post.title}
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                    loading="lazy" width="600" height="338"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-5xl">🐱</div>
                )}
              </div>
              <div class="p-5 flex flex-col flex-1">
                {post.tags?.[0] && (
                  <span class={`inline-flex self-start px-2.5 py-1 rounded-full text-xs font-bold border mb-2 ${tagColor(post.tags[0])}`}>
                    {tagLabel(post.tags[0])}
                  </span>
                )}
                <h2 class="font-body font-semibold text-gray-900 text-sm leading-snug mb-2 line-clamp-2 group-hover:text-terracotta transition-colors flex-1">
                  {post.title}
                </h2>
                {post.excerpt && (
                  <p class="text-gray-400 text-xs leading-relaxed line-clamp-2 mb-3">{post.excerpt}</p>
                )}
                <div class="flex items-center gap-2 text-xs text-gray-400 mt-auto pt-3 border-t border-gray-50">
                  <div class="w-5 h-5 bg-terracotta/80 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                    {(post.author || 'I').charAt(0).toUpperCase()}
                  </div>
                  {post.published_at && (
                    <span>{new Date(post.published_at).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      </>
    ) : (
      <div class="text-center py-20 bg-warm-white rounded-3xl">
        <p class="text-6xl mb-4">📝</p>
        <p class="text-xl font-display font-bold text-gray-950">Articles coming soon!</p>
        <p class="text-gray-400 mt-2 text-sm">Check back for expert cat care advice</p>
      </div>
    )}
  </div>
</Layout>