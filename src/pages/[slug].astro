---
export const prerender = false;
import { supabase } from '../lib/supabase';
import { PRUNED_POST_SLUGS } from '../lib/pruned-posts';
import { LEGACY_REDIRECTS } from '../lib/legacy-redirects';

const { slug } = Astro.params;

// Off-topic content pruned in the Phase 2 cleanup — permanent redirect, never rendered.
if (slug && PRUNED_POST_SLUGS.has(slug)) {
  return Astro.redirect('/blog', 301);
}

// Known WordPress-era URL with an explicit replacement — permanent redirect.
if (slug && LEGACY_REDIRECTS[slug]) {
  return Astro.redirect(LEGACY_REDIRECTS[slug], 301);
}

// /blog/[slug] is the canonical route for posts. Root-level slugs (legacy WordPress-era
// URLs) redirect there instead of rendering the same post — and serving its own set of
// AdSense units — a second time under a duplicate URL.
const { data: post } = await supabase
  .from('posts')
  .select('id')
  .eq('slug', slug!)
  .eq('is_published', true)
  .single();

// No known post and no known legacy mapping — a real 404, not a redirect to /blog.
if (!post) return Astro.rewrite('/404');

return Astro.redirect(`/blog/${slug}`, 301);
---
