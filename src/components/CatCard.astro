---
import { Image } from 'astro:assets';
import { getR2PublicUrl } from '../lib/r2';

interface Props {
  cat: {
    slug: string;
    title: string;
    breed: string;
    price: number;
    city: string;
    state: string;
    status?: string;
    cat_images: { storage_path: string; is_primary: boolean }[];
  }
}

const { cat } = Astro.props;
const primaryImage = cat.cat_images?.find(i => i.is_primary) || cat.cat_images?.[0];

const imgUrl = primaryImage ? getR2PublicUrl(primaryImage.storage_path) : null;
const isSold = cat.status === 'sold';
const isFree = cat.price === 0;
---
<a href={`/cats-for-sale/${cat.slug}`}
   class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border border-gray-100">

  <!-- Image -->
  <div class="relative overflow-hidden bg-warm-white" style="aspect-ratio: 4/3;">
    {imgUrl ? (
      <Image
        src={imgUrl}
        alt={`${cat.breed} kitten for sale in ${cat.city} ${cat.state} Australia`}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        width={400}
        height={300}
        quality={70}
        onerror="this.onerror=null; this.src='/placeholder-cat.svg';"
      />
    ) : (
      <img
        src="/placeholder-cat.svg"
        alt={`${cat.breed} kitten for sale in ${cat.city} ${cat.state} Australia`}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        width="400"
        height="300"
      />
    )}
    <!-- Price Badge -->
    <div class={`absolute top-3 right-3 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-md ${
      isSold ? 'bg-gray-500' : isFree ? 'bg-green-500' : 'bg-terracotta'
    }`}>
      {isSold ? 'SOLD' : isFree ? 'FREE' : `A$${cat.price.toLocaleString()}`}
    </div>
    <!-- Sold overlay -->
    {isSold && (
      <div class="absolute inset-0 bg-black/25 flex items-center justify-center">
        <span class="bg-white/95 text-gray-700 font-bold text-sm px-4 py-2 rounded-full shadow">SOLD</span>
      </div>
    )}
  </div>

  <!-- Info -->
  <div class="p-4">
    <p class="text-terracotta text-xs font-bold uppercase tracking-wider mb-1">{cat.breed}</p>
    <h3 class="font-body font-semibold text-gray-900 text-sm leading-snug mb-2 line-clamp-2 group-hover:text-terracotta transition-colors">
      {cat.title}
    </h3>
    <p class="text-gray-400 text-xs flex items-center gap-1">
      <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
      </svg>
      {cat.city}, {cat.state}
    </p>
  </div>
</a>